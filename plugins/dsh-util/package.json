{
  "name": "@dsh-plugin/dsh-util",
  "description": "Shared, framework-free primitives for the coordinator suite: one glob engine (rules gate, review-gate fence, org path envelope), one XML escaper, and the session-id normalizer.",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./error": {
      "types": "./lib/error.d.ts",
      "default": "./lib/error.js"
    },
    "./glob": {
      "types": "./lib/glob.d.ts",
      "default": "./lib/glob.js"
    },
    "./xml": {
      "types": "./lib/xml.d.ts",
      "default": "./lib/xml.js"
    },
    "./session": {
      "types": "./lib/session.d.ts",
      "default": "./lib/session.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
