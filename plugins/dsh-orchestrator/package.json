{
  "name": "@dsh-plugin/dsh-orchestrator",
  "description": "Coordinator-suite orchestrator: a customized review-loop goal carried by a disposable review-work subagent (per-round clean one-shot reviewers composed from @dsh-plugin/dsh-advisor's shared reviewer helper, a deterministic cross-round P0 count, and the two exits zero-P0-complete / human-decision-block) plus the recursive `subtask_parallel` fan-out tool with its three gates (maxDepth / maxTotalAgents / fanOut heuristics) over the shared @dsh-plugin/dsh-worker-spawn base.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./fanout": {
      "types": "./lib/fanout.d.ts",
      "default": "./lib/fanout.js"
    },
    "./findings": {
      "types": "./lib/findings.d.ts",
      "default": "./lib/findings.js"
    },
    "./loop": {
      "types": "./lib/loop.d.ts",
      "default": "./lib/loop.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.0-rc.2"
  },
  "dsh": {
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@dsh-plugin/dsh-advisor": "workspace:*",
    "@dsh-plugin/dsh-worker-spawn": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
