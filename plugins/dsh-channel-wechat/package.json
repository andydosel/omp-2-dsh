{
  "name": "@dsh-plugin/dsh-channel-wechat",
  "version": "0.1.0",
  "description": "WeChat (iLink Bot / ClawBot) channel plugin for dsh: long-poll inbound, per-peer agent sessions, chunked outbound.",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "import": "./lib/config.js"
    },
    "./adapter": {
      "types": "./lib/adapter.d.ts",
      "import": "./lib/adapter.js"
    },
    "./pairing": {
      "types": "./lib/pairing.d.ts",
      "import": "./lib/pairing.js"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
