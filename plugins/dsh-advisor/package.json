{
  "name": "@dsh-plugin/dsh-advisor",
  "description": "Optional reviewer model(s) attached to a session: reviews primary-transcript deltas with a restricted tool grant (read/grep/glob) and injects severity-graded advice (nit/concern/blocker). Port of omp's advisor subsystem for the DeepSeek Harness.",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./emission-guard": {
      "types": "./lib/emission-guard.d.ts",
      "default": "./lib/emission-guard.js"
    },
    "./delivery": {
      "types": "./lib/delivery.d.ts",
      "default": "./lib/delivery.js"
    },
    "./reviewer": {
      "types": "./lib/reviewer.d.ts",
      "default": "./lib/reviewer.js"
    },
    "./watchdog": {
      "types": "./lib/watchdog.d.ts",
      "default": "./lib/watchdog.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@dsh-plugin/dsh-util": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
